{
  "info": {
    "_postman_id": "7b8f9a2e-4e6f-4a0b-8d2b-6f81e39a1c1d",
    "name": "Full Stack Job Portal API Collection",
    "description": "Comprehensive Postman collection for Full Stack Job Portal with JWT Authentication, Jobs, and Application Management.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "jobId",
      "value": "",
      "type": "string"
    },
    {
      "key": "applicationId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alex Johnson\",\n  \"email\": \"alex@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"jobseeker\",\n  \"title\": \"Full Stack Developer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login User (Save Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.collectionVariables.set('token', res.token);",
                  "    console.log('JWT Token saved to collection variable:', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alex@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User Profile (Protected)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Jobs",
      "item": [
        {
          "name": "Get All Jobs",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (Array.isArray(res) && res.length > 0) {",
                  "    pm.collectionVariables.set('jobId', res[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/jobs",
              "host": ["{{baseUrl}}"],
              "path": ["jobs"]
            }
          }
        },
        {
          "name": "Filter Jobs by Category & Search",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/jobs?search=react&type=Full-Time",
              "host": ["{{baseUrl}}"],
              "path": ["jobs"],
              "query": [
                {
                  "key": "search",
                  "value": "react"
                },
                {
                  "key": "type",
                  "value": "Full-Time"
                }
              ]
            }
          }
        },
        {
          "name": "Get Single Job by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}",
              "host": ["{{baseUrl}}"],
              "path": ["jobs", "{{jobId}}"]
            }
          }
        },
        {
          "name": "Create Job (Protected)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Cloud Solutions Architect\",\n  \"company\": \"Amazon Web Services\",\n  \"location\": \"Seattle, WA (Hybrid)\",\n  \"type\": \"Full-Time\",\n  \"salary\": \"$170,000 - $220,000\",\n  \"description\": \"Design enterprise cloud transformations, scalable multi-region architectures, and high-availability serverless pipelines.\",\n  \"requirements\": [\"5+ years AWS experience\", \"Certified Solutions Architect\", \"Strong client consulting skills\"],\n  \"experienceLevel\": \"Senior Level\",\n  \"category\": \"DevOps\",\n  \"tags\": [\"AWS\", \"Cloud\", \"Terraform\", \"Architecture\"],\n  \"featured\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/jobs",
              "host": ["{{baseUrl}}"],
              "path": ["jobs"]
            }
          }
        }
      ]
    },
    {
      "name": "Applications",
      "item": [
        {
          "name": "Apply for Job (Protected)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jobId\": \"{{jobId}}\",\n  \"coverNote\": \"I have 5 years of React and Node.js experience and would love to contribute!\",\n  \"resumeUrl\": \"https://example.com/alex-resume.pdf\",\n  \"portfolioUrl\": \"https://github.com/alexjohnson\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/applications",
              "host": ["{{baseUrl}}"],
              "path": ["applications"]
            }
          }
        },
        {
          "name": "Get My Applications (Protected)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications/my",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "my"]
            }
          }
        },
        {
          "name": "Update Application Status (Protected)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Shortlisted\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "{{applicationId}}", "status"]
            }
          }
        }
      ]
    }
  ]
}
